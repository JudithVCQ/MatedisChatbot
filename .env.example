# Copiar a .env y completar. NUNCA subir .env a GitHub.
# Cualquier proveedor con API compatible con OpenAI. Ejemplos de LLM_BASE_URL:
#   Groq:   https://api.groq.com/openai/v1
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai
#   OpenAI: https://api.openai.com/v1
#   Ollama local: http://localhost:11434/v1
# Si se deja vacío, el sistema usa solo el extractor por palabras clave (plan B).
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
